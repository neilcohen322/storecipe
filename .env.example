# Local-only defaults. Copy to .env; never commit real credentials.
# Local role passwords are seeded by infra/postgres/init/001-local-roles.sql;
# rotating them means editing that script and the DSNs below together.
POSTGRES_DB=storecipe
POSTGRES_ADMIN_USER=storecipe_admin
POSTGRES_ADMIN_PASSWORD=local_admin_only

CATALOG_DATABASE_URL=postgresql+asyncpg://catalog_app:local_catalog_only@postgres:5432/storecipe
CATALOG_REDIS_URL=redis://redis:6379
CATALOG_REDIS_TIMEOUT_SECONDS=1
CATALOG_RECIPE_QUERY_CACHE_TTL_SECONDS=1800
CATALOG_MUTATION_BURST_REQUESTS=30
CATALOG_MUTATION_BURST_WINDOW_SECONDS=60
CATALOG_MEDIA_BUCKET=
CATALOG_MEDIA_MAX_INPUT_BYTES=8388608
CATALOG_MEDIA_MAX_PIXELS=12000000
CATALOG_MEDIA_MAX_OUTPUT_BYTES=1572864
CATALOG_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
INGESTION_DATABASE_URL=postgresql+asyncpg://ingestion_app:local_ingestion_only@postgres:5432/storecipe
INGESTION_REDIS_URL=redis://redis:6379
INGESTION_CELERY_BROKER_URL=redis://redis-broker:6379/0
INGESTION_IMPORT_DEADLINE_SECONDS=900
INGESTION_IMPORT_BURST_REQUESTS=5
INGESTION_IMPORT_BURST_WINDOW_SECONDS=60
INGESTION_AI_DAILY_TOKEN_LIMIT=1100000
INGESTION_AI_INVOCATION_RESERVATION_TOKENS=275000
INGESTION_PAYLOAD_ACTIVE_KEY_ID=local
INGESTION_PAYLOAD_KEYRING=local=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INGESTION_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

CATALOG_PORT=8000
INGESTION_PORT=8001
MCP_PORT=8002
LOG_LEVEL=INFO

# OAuth settings. Empty values make protected endpoints fail closed.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=
# AUTH0_AUDIENCE is the canonical Storecipe API resource; MCP_RESOURCE_URL is
# the public gateway resource and inbound MCP token audience served by Caddy.
MCP_RESOURCE_URL=http://localhost/mcp
MCP_CATALOG_API_URL=http://catalog-api:8000
MCP_INGESTION_API_URL=http://ingestion-api:8001
MCP_CATALOG_MAX_RESPONSE_BYTES=2097152
MCP_CONNECT_TIMEOUT_SECONDS=5
MCP_POOL_TIMEOUT_SECONDS=5
MCP_READ_TIMEOUT_SECONDS=10
MCP_WRITE_TIMEOUT_SECONDS=10
# Confidential Auth0 client used by the gateway for RFC 8693 On-Behalf-Of
# exchange into AUTH0_AUDIENCE before Catalog REST calls. Gateway auth is
# all-or-none: AUTH0_ISSUER, AUTH0_AUDIENCE, MCP_OBO_CLIENT_ID, and
# MCP_OBO_CLIENT_SECRET together (token URL may be explicit or derived from
# the issuer). Leave all Auth0/OBO values empty for local infrastructure checks.
MCP_OBO_CLIENT_ID=
MCP_OBO_CLIENT_SECRET=
MCP_OBO_TOKEN_URL=
MCP_OBO_EXPIRY_MARGIN_SECONDS=30

# Optional AI extraction settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
AI_EXTRACTION_ENABLED=false
INGESTION_SERVER_RENDERED_VARIANT_HOSTS_JSON={}

# Optional Redis instance used exclusively by Redis integration tests.
STORECIPE_TEST_REDIS_URL=

# Ingestion API/worker Catalog M2M settings.
CATALOG_API_URL=http://catalog-api:8000
CATALOG_M2M_TOKEN_URL=
CATALOG_M2M_CLIENT_ID=
CATALOG_M2M_CLIENT_SECRET=
CATALOG_M2M_AUDIENCE=

# Expo web Auth0 SPA (API audience — not MCP_RESOURCE_URL)
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Expo web API bases (optional; defaults shown)
EXPO_PUBLIC_CATALOG_API_URL=http://localhost:8000
EXPO_PUBLIC_INGESTION_API_URL=http://localhost:8001

# Production-only names. There are intentionally no production credential defaults.
PUBLIC_HOST=
PUBLIC_ORIGIN=
STORECIPE_WEB_IMAGE=
STORECIPE_CATALOG_IMAGE=
STORECIPE_INGESTION_IMAGE=
STORECIPE_MCP_IMAGE=
CATALOG_DB_PASSWORD=
INGESTION_DB_PASSWORD=
GCP_MEDIA_BUCKET=
GCP_BACKUP_BUCKET=
GCP_RUNTIME_SECRET_NAME=
