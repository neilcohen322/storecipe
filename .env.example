# Local-only defaults. Copy to .env; never commit real credentials.
# Local role passwords are seeded by infra/postgres/init/001-local-roles.sql;
# rotating them means editing that script and the DSNs below together.
POSTGRES_DB=storecipe
POSTGRES_ADMIN_USER=storecipe_admin
POSTGRES_ADMIN_PASSWORD=local_admin_only

CATALOG_DATABASE_URL=postgresql+asyncpg://catalog_app:local_catalog_only@postgres:5432/storecipe
CATALOG_REDIS_URL=redis://redis:6379
CATALOG_REDIS_TIMEOUT_SECONDS=1
CATALOG_RECIPE_QUERY_CACHE_TTL_SECONDS=1800
INGESTION_DATABASE_URL=postgresql+asyncpg://ingestion_app:local_ingestion_only@postgres:5432/storecipe
INGESTION_REDIS_URL=redis://redis:6379
INGESTION_CELERY_BROKER_URL=redis://redis-broker:6379/0
INGESTION_IMPORT_DEADLINE_SECONDS=900
INGESTION_IMPORT_BURST_REQUESTS=5
INGESTION_IMPORT_BURST_WINDOW_SECONDS=60
INGESTION_AI_DAILY_TOKEN_LIMIT=1100000
INGESTION_AI_INVOCATION_RESERVATION_TOKENS=275000
INGESTION_PAYLOAD_ACTIVE_KEY_ID=local
INGESTION_PAYLOAD_KEYRING=local=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

CATALOG_PORT=8000
INGESTION_PORT=8001
LOG_LEVEL=INFO

# OAuth settings. Empty values make protected endpoints fail closed.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_JWKS_URL=
MCP_RESOURCE_URL=http://localhost:8000/mcp

# Optional AI extraction settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-nano
AI_EXTRACTION_ENABLED=false

# Optional Redis instance used exclusively by Redis integration tests.
STORECIPE_TEST_REDIS_URL=

# Ingestion API/worker Catalog M2M settings.
CATALOG_API_URL=http://catalog-api:8000
CATALOG_M2M_TOKEN_URL=
CATALOG_M2M_CLIENT_ID=
CATALOG_M2M_CLIENT_SECRET=
CATALOG_M2M_AUDIENCE=
