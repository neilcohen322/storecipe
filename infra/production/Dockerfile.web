FROM node:24-alpine AS web-build

RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
WORKDIR /workspace/apps/web

COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/web/ ./

ARG EXPO_PUBLIC_AUTH0_DOMAIN
ARG EXPO_PUBLIC_AUTH0_CLIENT_ID
ARG EXPO_PUBLIC_AUTH0_AUDIENCE
ARG EXPO_PUBLIC_CATALOG_API_URL
ARG EXPO_PUBLIC_INGESTION_API_URL
ARG EXPO_PUBLIC_LEGAL_OPERATOR_NAME
ARG EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL
ARG EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE
ENV EXPO_PUBLIC_AUTH0_DOMAIN=${EXPO_PUBLIC_AUTH0_DOMAIN} \
    EXPO_PUBLIC_AUTH0_CLIENT_ID=${EXPO_PUBLIC_AUTH0_CLIENT_ID} \
    EXPO_PUBLIC_AUTH0_AUDIENCE=${EXPO_PUBLIC_AUTH0_AUDIENCE} \
    EXPO_PUBLIC_CATALOG_API_URL=${EXPO_PUBLIC_CATALOG_API_URL} \
    EXPO_PUBLIC_INGESTION_API_URL=${EXPO_PUBLIC_INGESTION_API_URL} \
    EXPO_PUBLIC_LEGAL_OPERATOR_NAME=${EXPO_PUBLIC_LEGAL_OPERATOR_NAME} \
    EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=${EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL} \
    EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE=${EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE}

RUN test -n "$EXPO_PUBLIC_AUTH0_DOMAIN" \
 && test -n "$EXPO_PUBLIC_AUTH0_CLIENT_ID" \
 && test -n "$EXPO_PUBLIC_AUTH0_AUDIENCE" \
 && test -n "$EXPO_PUBLIC_CATALOG_API_URL" \
 && test -n "$EXPO_PUBLIC_INGESTION_API_URL" \
 && for value in \
      "$EXPO_PUBLIC_LEGAL_OPERATOR_NAME" \
      "$EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL" \
      "$EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE"; do \
      test -n "$value"; \
      case "$value" in *'<'*|*'>'*|CHANGE_ME|changeme|TODO|todo|TBD|tbd|placeholder) exit 1 ;; esac; \
    done \
 && printf '%s' "$EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL" | grep -Eq '^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$' \
 && printf '%s' "$EXPO_PUBLIC_LEGAL_EFFECTIVE_DATE" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' \
 && pnpm run test:production-bundle

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
COPY infra/production/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /workspace/apps/web/dist /srv/web

EXPOSE 80 443
