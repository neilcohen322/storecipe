[Unit]
Description=Storecipe orphaned media reconciliation
Requires=docker.service
After=docker.service storecipe-backup.service
ConditionPathExists=/opt/storecipe/current/compose.yaml

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/storecipe/current
ExecStart=/usr/local/sbin/storecipe-runtime-operation media-reconcile
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
